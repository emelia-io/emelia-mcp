{
  "inputs": [
    {
      "type": "promptString",
      "id": "emelia-api-key",
      "description": "Emelia API key",
      "password": true
    }
  ],
  "servers": {
    "emelia": {
      "type": "http",
      "url": "https://mcp.emelia.io/mcp",
      "headers": {
        "Authorization": "${input:emelia-api-key}"
      }
    }
  }
}
